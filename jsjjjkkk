-- wind_ui.lua — Wind UI style, by kindmops
local P   = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TS  = game:GetService("TweenService")
local L   = P.LocalPlayer

local ACCENT   = Color3.fromRGB(255, 120, 40)
local ACCENT_B = Color3.fromRGB(255, 60, 160)
local BG       = Color3.fromRGB(18, 16, 22)
local BG_SOFT  = Color3.fromRGB(26, 22, 30)
local BG_ROW   = Color3.fromRGB(34, 28, 38)
local TEXT     = Color3.fromRGB(245, 242, 238)
local TEXT_DIM = Color3.fromRGB(150, 145, 155)

local WindUI = {}
WindUI.__index = WindUI

function WindUI.new(opts)
    opts = opts or {}
    local self = setmetatable({}, WindUI)
    self.sections = {}
    self.flags = {}
    self.currentTab = nil
    self.tabs = {}

    local gui = Instance.new("ScreenGui")
    gui.Name = "WindUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = L:WaitForChild("PlayerGui")
    self.gui = gui

    -- backdrop с блюром
    local backdrop = Instance.new("Frame")
    backdrop.Size = UDim2.new(1, 0, 1, 0)
    backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
    backdrop.BackgroundTransparency = 1
    backdrop.BorderSizePixel = 0
    backdrop.Visible = false
    backdrop.ZIndex = 1
    backdrop.Parent = gui
    self.backdrop = backdrop

    -- FAB
    local fab = Instance.new("TextButton")
    fab.Size = UDim2.new(0, 58, 0, 58)
    fab.Position = UDim2.new(0, 16, 0.5, 200)
    fab.BackgroundColor3 = ACCENT
    fab.BorderSizePixel = 0
    fab.Text = opts.FabText or "W"
    fab.TextColor3 = Color3.new(1, 1, 1)
    fab.Font = Enum.Font.GothamBold
    fab.TextSize = 22
    fab.ZIndex = 10
    fab.Parent = gui
    Instance.new("UICorner", fab).CornerRadius = UDim.new(1, 0)
    local fg = Instance.new("UIGradient", fab)
    fg.Color = ColorSequence.new(ACCENT, ACCENT_B)
    fg.Rotation = 45

    -- Panel
    local PSIZE = UDim2.new(0, 340, 0, 460)
    local panel = Instance.new("Frame")
    panel.Size = PSIZE
    panel.Position = UDim2.new(0.5, -170, 0.5, -230)
    panel.BackgroundColor3 = BG
    panel.BackgroundTransparency = 0.05
    panel.BorderSizePixel = 0
    panel.Visible = false
    panel.Active = true
    panel.ZIndex = 5
    panel.Parent = gui
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 16)
    local ps = Instance.new("UIStroke", panel)
    ps.Color = ACCENT
    ps.Thickness = 1.5
    ps.Transparency = 0.4
    self.panel = panel

    -- Gradient header
    local head = Instance.new("Frame")
    head.Size = UDim2.new(1, 0, 0, 52)
    head.BackgroundColor3 = BG_SOFT
    head.BorderSizePixel = 0
    head.ZIndex = 6
    head.Parent = panel
    Instance.new("UICorner", head).CornerRadius = UDim.new(0, 16)
    -- прижать углы снизу
    local headFix = Instance.new("Frame")
    headFix.Size = UDim2.new(1, 0, 0.5, 0)
    headFix.Position = UDim2.new(0, 0, 0.5, 0)
    headFix.BackgroundColor3 = BG_SOFT
    headFix.BorderSizePixel = 0
    headFix.ZIndex = 6
    headFix.Parent = head

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -110, 1, 0)
    title.Position = UDim2.new(0, 18, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = opts.Title or "WindUI  •  kindmops"
    title.TextColor3 = TEXT
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold
    title.TextSize = 16
    title.ZIndex = 7
    title.Parent = head

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 34, 0, 34)
    close.Position = UDim2.new(1, -44, 0, 9)
    close.BackgroundColor3 = BG_ROW
    close.Text = "✕"
    close.TextColor3 = TEXT
    close.Font = Enum.Font.GothamBold
    close.TextSize = 15
    close.BorderSizePixel = 0
    close.ZIndex = 8
    close.Parent = head
    Instance.new("UICorner", close).CornerRadius = UDim.new(0, 8)

    -- Tabs bar
    local tabsBar = Instance.new("Frame")
    tabsBar.Size = UDim2.new(1, -24, 0, 34)
    tabsBar.Position = UDim2.new(0, 12, 0, 58)
    tabsBar.BackgroundTransparency = 1
    tabsBar.ZIndex = 6
    tabsBar.Parent = panel
    local tl = Instance.new("UIListLayout", tabsBar)
    tl.FillDirection = Enum.FillDirection.Horizontal
    tl.Padding = UDim.new(0, 6)
    tl.SortOrder = Enum.SortOrder.LayoutOrder
    self.tabsBar = tabsBar

    -- Content
    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, -20, 1, -104)
    content.Position = UDim2.new(0, 10, 0, 100)
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.ScrollBarThickness = 3
    content.ScrollBarImageColor3 = ACCENT
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    content.ZIndex = 6
    content.Parent = panel
    self.content = content
    local cl = Instance.new("UIListLayout", content)
    cl.Padding = UDim.new(0, 8)
    cl.SortOrder = Enum.SortOrder.LayoutOrder
    self.list = cl

    -- open/close анимация
    local function openAnim(open)
        if open then
            panel.Visible = true
            backdrop.Visible = true
            panel.Size = UDim2.new(0, 340, 0, 0)
            panel.BackgroundTransparency = 1
            TS:Create(panel, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = PSIZE, BackgroundTransparency = 0.05,
            }):Play()
            TS:Create(backdrop, TweenInfo.new(0.22), { BackgroundTransparency = 0.6 }):Play()
        else
            local tw = TS:Create(panel, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 340, 0, 0), BackgroundTransparency = 1,
            })
            tw:Play()
            TS:Create(backdrop, TweenInfo.new(0.16), { BackgroundTransparency = 1 }):Play()
            tw.Completed:Connect(function()
                panel.Visible = false
                backdrop.Visible = false
            end)
        end
    end
    self.openAnim = openAnim

    close.MouseButton1Click:Connect(function() openAnim(false) end)
    fab.MouseButton1Click:Connect(function()
        if panel.Visible then openAnim(false) else openAnim(true) end
    end)

    -- drag
    local dragStart, startPos
    head.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragStart = input.Position
            startPos = panel.Position
        end
    end)
    head.InputChanged:Connect(function(input)
        if dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                       startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragStart = nil
        end
    end)

    return self
end

-- tab(name)
function WindUI:tab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 92, 1, 0)
    btn.BackgroundColor3 = BG_SOFT
    btn.BorderSizePixel = 0
    btn.Text = name
    btn.TextColor3 = TEXT_DIM
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.ZIndex = 7
    btn.Parent = self.tabsBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local td = { name = name, button = btn, items = {} }
    self.tabs[name] = td

    local function activate()
        for _, t in pairs(self.tabs) do
            t.button.TextColor3 = TEXT_DIM
            t.button.BackgroundColor3 = BG_SOFT
            for _, it in ipairs(t.items) do it.Visible = false end
        end
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.BackgroundColor3 = ACCENT
        for _, it in ipairs(td.items) do it.Visible = true end
        self.currentTab = name
    end
    btn.MouseButton1Click:Connect(activate)
    if not self.currentTab then activate() end
    return td
end

function WindUI:_cur()
    if not self.currentTab then error("no tab") end
    return self.tabs[self.currentTab]
end

-- секция (аккордеон) — Wind UI signature
function WindUI:section(name)
    local tab = self:_cur()

    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, -8, 0, 44)
    wrap.BackgroundColor3 = BG_SOFT
    wrap.BorderSizePixel = 0
    wrap.ClipsDescendants = true
    wrap.ZIndex = 7
    wrap.Parent = self.content
    Instance.new("UICorner", wrap).CornerRadius = UDim.new(0, 10)

    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, 0, 0, 44)
    header.BackgroundTransparency = 1
    header.Text = ""
    header.ZIndex = 8
    header.Parent = wrap

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -50, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = TEXT
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.ZIndex = 9
    lbl.Parent = header

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 30, 0, 44)
    arrow.Position = UDim2.new(1, -36, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▾"
    arrow.TextColor3 = ACCENT
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 16
    arrow.ZIndex = 9
    arrow.Parent = header

    local inner = Instance.new("Frame")
    inner.Size = UDim2.new(1, -16, 0, 0)
    inner.Position = UDim2.new(0, 8, 0, 48)
    inner.BackgroundTransparency = 1
    inner.ZIndex = 8
    inner.Parent = wrap
    local il = Instance.new("UIListLayout", inner)
    il.Padding = UDim.new(0, 6)
    il.SortOrder = Enum.SortOrder.LayoutOrder
    il.Changed:Connect(function()
        inner.Size = UDim2.new(1, -16, 0, il.AbsoluteContentSize.Y)
        if wrap.Size.Y.Offset > 44 then
            wrap.Size = UDim2.new(1, -8, 0, 48 + il.AbsoluteContentSize.Y + 8)
        end
    end)

    local open = true
    local function redraw()
        arrow.Rotation = open and 0 or -90
        if open then
            wrap.Size = UDim2.new(1, -8, 0, 48 + il.AbsoluteContentSize.Y + 8)
        else
            wrap.Size = UDim2.new(1, -8, 0, 44)
        end
    end
    header.MouseButton1Click:Connect(function()
        open = not open
        redraw()
    end)

    local section = { frame = wrap, inner = inner }
    table.insert(tab.items, wrap)

    -- методы добавления элементов в секцию
    function section:toggle(name, default, cb)
        local state = default or false
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 48)
        row.BackgroundColor3 = BG_ROW
        row.BorderSizePixel = 0
        row.Text = ""
        row.AutoButtonColor = false
        row.ZIndex = 9
        row.Parent = inner
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -80, 1, 0)
        l.Position = UDim2.new(0, 12, 0, 0)
        l.BackgroundTransparency = 1
        l.Text = name
        l.TextColor3 = TEXT
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Font = Enum.Font.Gotham
        l.TextSize = 13
        l.ZIndex = 10
        l.Parent = row

        local pill = Instance.new("Frame")
        pill.Size = UDim2.new(0, 48, 0, 26)
        pill.Position = UDim2.new(1, -60, 0.5, -13)
        pill.BackgroundColor3 = Color3.fromRGB(60, 54, 64)
        pill.BorderSizePixel = 0
        pill.ZIndex = 10
        pill.Parent = row
        Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 20, 0, 20)
        knob.Position = UDim2.new(0, 3, 0.5, -10)
        knob.BackgroundColor3 = Color3.fromRGB(210, 205, 200)
        knob.BorderSizePixel = 0
        knob.ZIndex = 11
        knob.Parent = pill
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local function redraw2()
            TS:Create(pill, TweenInfo.new(0.14), {
                BackgroundColor3 = state and ACCENT or Color3.fromRGB(60, 54, 64)
            }):Play()
            TS:Create(knob, TweenInfo.new(0.14), {
                Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
            }):Play()
        end
        row.MouseButton1Click:Connect(function()
            state = not state
            redraw2()
            if cb then cb(state) end
        end)
        redraw2()

        self.flags[name] = {
            get = function() return state end,
            set = function(v) state = v redraw2() if cb then cb(v) end end
        }
        return self.flags[name]
    end

    function section:slider(name, min, max, default, cb)
        local value = default or min
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 58)
        row.BackgroundColor3 = BG_ROW
        row.BorderSizePixel = 0
        row.ZIndex = 9
        row.Parent = inner
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -24, 0, 22)
        l.Position = UDim2.new(0, 12, 0, 5)
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextColor3 = TEXT
        l.Font = Enum.Font.Gotham
        l.TextSize = 13
        l.ZIndex = 10
        l.Parent = row

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -24, 0, 6)
        track.Position = UDim2.new(0, 12, 0, 40)
        track.BackgroundColor3 = Color3.fromRGB(60, 54, 64)
        track.BorderSizePixel = 0
        track.ZIndex = 10
        track.Parent = row
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.BackgroundColor3 = ACCENT
        fill.BorderSizePixel = 0
        fill.ZIndex = 11
        fill.Parent = track
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
        local g = Instance.new("UIGradient", fill)
        g.Color = ColorSequence.new(ACCENT, ACCENT_B)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 18, 0, 18)
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.BorderSizePixel = 0
        knob.ZIndex = 12
        knob.Parent = track
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local function apply(x)
            local t = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * t)
            fill.Size = UDim2.new(t, 0, 1, 0)
            knob.Position = UDim2.new(t, 0, 0.5, 0)
            l.Text = name .. ": " .. value
            if cb then cb(value) end
        end

        local dragging = false
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                apply(input.Position.X)
            end
        end)
        track.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                apply(input.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        local t = (value - min) / (max - min)
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, 0, 0.5, 0)
        l.Text = name .. ": " .. value

        self.flags[name] = {
            get = function() return value end,
            set = function(v)
                apply(track.AbsolutePosition.X + track.AbsoluteSize.X * ((v - min) / (max - min)))
            end
        }
        return self.flags[name]
    end

    function section:button(name, cb)
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 44)
        row.BackgroundColor3 = ACCENT
        row.BorderSizePixel = 0
        row.Text = name
        row.TextColor3 = Color3.new(1, 1, 1)
        row.Font = Enum.Font.GothamBold
        row.TextSize = 13
        row.ZIndex = 9
        row.Parent = inner
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
        local gr = Instance.new("UIGradient", row)
        gr.Color = ColorSequence.new(ACCENT, ACCENT_B)
        row.MouseButton1Click:Connect(function() if cb then cb() end end)
        return row
    end

    function section:label(text)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, 30)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = TEXT_DIM
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Font = Enum.Font.Gotham
        l.TextSize = 12
        l.ZIndex = 9
        l.Parent = inner
        return l
    end

    return section
end

function WindUI:destroy()
    if self.gui then self.gui:Destroy() end
end

return WindUI
